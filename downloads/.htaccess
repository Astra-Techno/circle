<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|release\.json|circle\.apk)$">
        Header set Cache-Control "no-store, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "^circle-[0-9]+\.[0-9]+\.[0-9]+-[0-9]+\.apk$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# The deployer intentionally skips APK binaries. Missing current immutable APKs
# use the repository copy while retaining a versioned download link on this site.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(circle-[0-9]+\.[0-9]+\.[0-9]+-[0-9]+\.apk)$ download.php?file=$1 [END]
</IfModule>
