# Copy to .env (never commit .env). All values below are local-development examples.
APP_ENV=development
# Error details are never sent to clients; they go to the redacted error log.
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=circle
DB_USERNAME=circle
DB_PASSWORD=

# REQUIRED: at least 32 random bytes. The API refuses to serve requests when
# this is empty, short or a placeholder. Generate one with:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=
# Access token lifetime (seconds) and refresh/session lifetime (seconds).
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Comma-separated exact origins allowed for browser access. Empty = none
# (the mobile app does not need CORS).
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
LOGIN_MAX_FAILURES_PER_MOBILE=10

# ── Private media (ADR 0007) ─────────────────────────────────
# Photo uploads need the PHP GD extension (Ubuntu: sudo apt install php8.3-gd).
# Without it upload requests fail closed with 503 and nothing is stored. GD
# cannot decode HEIC, so HEIC uploads are refused (415) until an Imagick
# processor with libheif support is added.
# Folder for re-encoded photos. MUST be outside public/. Empty = backend/storage/media.
MEDIA_STORAGE_PATH=
# REQUIRED for media: at least 32 random bytes, different from JWT_SECRET.
# Media endpoints refuse to work when it is empty, short, a placeholder or
# equal to JWT_SECRET. Generate one with:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
MEDIA_SIGNING_SECRET=
# Lifetime of signed photo links in seconds (30..3600).
MEDIA_LINK_TTL=300
# Largest accepted upload in bytes (at most 15 MiB).
MEDIA_MAX_BYTES=15728640
# Largest accepted image in pixels (decompression-bomb guard; PHP memory_limit
# must cover about 5 bytes per pixel).
MEDIA_MAX_PIXELS=40000000
# Files of deleted photos are purged this many days after deletion.
MEDIA_PURGE_AFTER_DAYS=7
# Upload tickets per person per hour, and unattached uploads per person.
MEDIA_UPLOADS_PER_HOUR=60
MEDIA_MAX_OPEN_UPLOADS=50
# How photo bytes are sent: none (PHP streams them), x-sendfile (Apache
# mod_xsendfile) or x-accel-redirect (nginx internal location; see
# MEDIA_ACCEL_PREFIX, which must map to MEDIA_STORAGE_PATH as `internal`).
MEDIA_SENDFILE_MODE=none
MEDIA_ACCEL_PREFIX=/protected-media
