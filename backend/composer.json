{
    "name": "circle/api",
    "description": "CIRCLE private groups API — lightweight PHP/MySQL REST backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Circle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Circle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse src --level=6",
        "migrate": "php src/Core/migrate.php",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
